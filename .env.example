# Copia este archivo como .env (en la raíz del repo) y ajusta los valores. Nunca subas .env al repositorio.

# --- Base de datos (coincide con docker-compose.yml) ---
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=inventario
POSTGRES_PORT=5432

# --- API (Django) ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Si la contraseña tiene caracteres especiales (@ : / #), codifícalos en la URL.
DATABASE_URL=postgresql://inventario:cambia-esta-clave@localhost:5432/inventario

# Clave secreta de Django (sin valor por defecto: la API no arranca sin ella). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=reemplaza-por-un-valor-largo-y-aleatorio

# Origen permitido por CORS (el frontend). Se usa cuando el frontend empiece a llamar a la API.
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
