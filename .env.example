# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# --- Base de datos (coincide con docker-compose.yml) ---
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=inventario
POSTGRES_PORT=5432

# --- API ---
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://inventario:cambia-esta-clave@localhost:5432/inventario

# Secreto para firmar sesiones/tokens. Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=reemplaza-por-un-valor-largo-y-aleatorio

# Origen permitido por CORS (el frontend)
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000
